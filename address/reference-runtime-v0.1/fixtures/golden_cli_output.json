      "address_id",
      "evaluated_at",
      "decision",
      "reason",
      "detail_digest",
      "evidence_digests",
      "audit_id"
    ],
    "schema_version": "ADDRESS-AUDIT-1.0",
    "decision_must_match_resolution": true,
    "reason_must_match_resolution": true
  },
  "forbidden_public_fields": [
    "value_filled",
    "secret",
    "target_value_payload"
  ]
